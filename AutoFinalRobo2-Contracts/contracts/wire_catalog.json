    { "id": "0x18", "name": "POSE", "family": "EX01", "ws": null,
      "does": "Pose y odometria.",
      "request": { "bytes": 0 },
      "reply": { "bytes": 25, "fields": [ { "name": "pose_valid", "type": "u8" }, { "name": "x", "type": "i32le", "unit": "mm" }, { "name": "y", "type": "i32le", "unit": "mm" }, { "name": "yaw", "type": "i32le", "unit": "mrad" }, { "name": "age", "type": "u32le", "unit": "ms" }, { "name": "frame", "type": "u32le" }, { "name": "sequence", "type": "u32le" } ] } },
    { "id": "0x19", "name": "HALL_CAL", "family": "EX01", "ws": null, "retired": true,
