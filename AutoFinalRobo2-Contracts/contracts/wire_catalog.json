    { "id": "0x16", "name": "GOTO", "family": "EX01", "ws": "robot.goto.start",
      "does": "Destino relativo X/Y; opcional giro y velocidad (16 B).",
      "request": { "bytes": [12, 16], "fields": [ { "name": "reserved", "type": "u32le" }, { "name": "x", "type": "i32le", "unit": "mm" }, { "name": "y", "type": "i32le", "unit": "mm" }, { "name": "theta", "type": "i16le", "optional": true }, { "name": "speed", "type": "u16le", "optional": true } ] },
      "reply": { "bytes": 0 } },
    { "id": "0x17", "name": "CANCEL", "family": "EX01", "ws": "robot.goto.cancel",
