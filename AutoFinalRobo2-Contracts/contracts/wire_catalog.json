      "request": { "bytes": 0 },
      "reply": { "bytes": 2, "fields": [ { "name": "stopped", "type": "u8" }, { "name": "mode", "type": "u8" } ] } },

    { "id": "0x10", "name": "EXT_HELLO", "family": "EX01", "ws": null,
