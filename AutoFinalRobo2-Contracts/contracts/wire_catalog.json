{
  "schema": "afr2-wire-catalog-1",
  "updated_by": "AFR2-20261110-14",
  "notes": "Catalogo de comandos UART ROBO2/perfil 2 + EX01 v13 para interpretes (Loader, Protocol Studio). Autoridad de IDs: afr2_wire.h, afr2_product_wire.h, afr2_sensor_wire.h, afr2_network_wire.h, afr2_battery_wire.h. Largos cotejados con el despachador del ATmega (afr2_link.c, afr2_app_wire.c, afr2_sensor_commands.c, afr2_network.c, afr2_sequence.c) el 08/11/2026; sin prueba en placa. Toda alta/baja/modificacion de un CMD actualiza este archivo (skill afr2-wire-commands). 'bytes' cuenta el cuerpo de aplicacion, sin sesion/transaccion/resultado. 'variable' indica largo dependiente del contenido.",
  "envelope": {
    "header": "52 4F 42 4F 32",
    "tokens": "3A A5",
    "version": 1,
    "payload_max": 64,
    "overhead": 12,
    "layout": "header[5] N[1] tokenA tokenB version route cmd payload[N] xor",
    "checksum": "xor de todos los bytes anteriores, cabecera incluida",
    "routes": {
      "0x31": "ESP -> ATmega (pedido)",
      "0x13": "ATmega -> ESP (respuesta)"
    },
    "request_prefix": [
      { "name": "session", "type": "u32le" },
      { "name": "transaction", "type": "u32le" }
    ],
    "response_prefix": [
      { "name": "session", "type": "u32le" },
      { "name": "transaction", "type": "u32le" },
      { "name": "result", "type": "u8", "enum": "result" }
    ],
    "no_prefix": ["0x52"],
    "error_reply": "Con result != OK la respuesta no lleva cuerpo (N = 9)."
  },
  "commands": [
    { "id": "0x01", "name": "HELLO", "family": "base", "ws": null,
      "does": "Abre la sesion ROBO2 / perfil 2. Una sesion nueva detiene movimiento.",
      "request": { "bytes": 5, "fields": [ { "name": "product", "type": "ascii:4" }, { "name": "profile", "type": "u8" } ] },
      "reply": { "bytes": 14, "fields": [ { "name": "product", "type": "ascii:4" }, { "name": "profile", "type": "u8" }, { "name": "fw_major", "type": "u8" }, { "name": "fw_minor", "type": "u8" }, { "name": "fw_patch", "type": "u8" }, { "name": "capabilities", "type": "u16le", "format": "hex" }, { "name": "uptime", "type": "u32le", "unit": "ms" } ] } },
    { "id": "0x02", "name": "ALIVE", "family": "base", "ws": null,
      "does": "Latido: devuelve el tiempo encendido del ATmega.",
      "request": { "bytes": 0 },
      "reply": { "bytes": 4, "fields": [ { "name": "uptime", "type": "u32le", "unit": "ms" } ] } },
    { "id": "0x03", "name": "STATE", "family": "base", "ws": null,
      "does": "Estado base: modo, parada confirmada y edad.",
      "request": { "bytes": 0 },
      "reply": { "bytes": 7, "fields": [ { "name": "mode", "type": "u8" }, { "name": "stopped", "type": "u8" }, { "name": "reserved", "type": "u8" }, { "name": "age", "type": "u32le", "unit": "ms" } ] } },
    { "id": "0x04", "name": "SENSORS", "family": "base", "ws": "robot.sensors",
      "does": "Linea (5 bits) y distancia ultrasonica del perfil base.",
      "request": { "bytes": 0 },
      "reply": { "bytes": 13, "fields": [ { "name": "line_valid", "type": "u8" }, { "name": "line_bits", "type": "u8", "format": "bin" }, { "name": "line_age", "type": "u32le", "unit": "ms" }, { "name": "us_valid", "type": "u8" }, { "name": "distance", "type": "u16le", "unit": "mm" }, { "name": "us_age", "type": "u32le", "unit": "ms" } ] } },
    { "id": "0x05", "name": "ENCODERS", "family": "base", "ws": "robot.encoders",
      "does": "Cuentas Hall FL / FR / RL / RR.",
      "request": { "bytes": 0 },
      "reply": { "bytes": 22, "fields": [ { "name": "wired", "type": "u8" }, { "name": "valid", "type": "u8" }, { "name": "fl", "type": "i32le" }, { "name": "fr", "type": "i32le" }, { "name": "rl", "type": "i32le" }, { "name": "rr", "type": "i32le" }, { "name": "age", "type": "u32le", "unit": "ms" } ] } },
    { "id": "0x06", "name": "STOP", "family": "base", "ws": "robot.stop",
