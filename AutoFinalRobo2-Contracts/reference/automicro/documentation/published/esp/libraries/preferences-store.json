  "id": "esp:module/src/nvs_store.h",
  "slug": "preferences-store",
  "title": "Preferencias NVS y caché",
  "target": "esp",
  "kind": "servicio",
  "status": "source-documented",
  "snapshotDate": "2026-10-20",
  "verification": "not-run-user-instruction",
  "responsibility": "Carga/persiste AppConfig con caché, migración y recuperación de respaldo.",
  "scope": "Transacción lógica de configuración; filesystem y codec se prestan por NvsStoreOps.",
  "state": "NvsStoreHandle posee ops copiado, cached, valid y mounted. GetCached devuelve vista const de su almacenamiento, no una copia independiente.",
  "modularity": "Núcleo de store usa operaciones; nvs_utils es adaptación histórica. AppConfig sigue siendo esquema del producto.",
  "lifecycle": [
    "Init conecta backend; InitAndLoad monta y elige archivo/defaults/migración.",
    "Save solicita escritura mediante el backend y actualiza caché según resultado.",
    "RestoreBackup recupera configuración guardada si puede hacerlo."
  ],
  "interactions": [
    "Wi-Fi consume configuración; bridge distingue cambios persistentes y de sesión."
  ],
  "limitations": [
    "No exponer contraseñas o PIN de cached como documentación/JSON de diagnóstico.",
    "Un callback de escritura sigue pudiendo bloquear el loop."
  ],
