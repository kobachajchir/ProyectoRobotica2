  "verification": "not-run-user-instruction",
  "responsibility": "Conecta el servicio Wi-Fi con el runtime Arduino y conserva su API de aplicación.",
  "scope": "Bindings del driver/config/reloj y reenvíos a WifiService.",
  "state": "Instancia del servicio y configuración de sesión; distinguir configuración temporal de NVS persistida.",
  "modularity": "Fachada específica ESP; no duplicar su estado dentro del bridge.",
  "lifecycle": [
    "Begin prepara servicio en setup; Loop lo atiende.",
    "Cambios temporales pueden aplicar configuración de sesión sin escribir NVS."
  ],
  "interactions": [
    "BridgeWifiPort y UNER_AppServices delegan operaciones aquí."
  ],
  "limitations": [
    "Una configuración en RAM no sobrevive a reinicio salvo guardado explícito."
  ],
