  "id": "f4:module/Core/Inc/screen_lock.h",
  "slug": "screen-lock",
  "title": "Bloqueo de pantalla por inactividad",
  "target": "f4",
  "kind": "integración",
  "status": "source-documented",
  "verification": "not-run-user-instruction",
  "snapshotDate": "2026-10-20",
  "responsibility": "Aplica bloqueo visual por inactividad y controla edición del tiempo de bloqueo.",
  "scope": "Temporización y filtrado de eventos locales; no sustituye las sesiones PIN remotas de Permission.",
  "state": "El estado vive en ScreensState: locked, ticks de inactividad, borrador y renderer/eventos anteriores. El API usa Screens_Context implícito.",
  "lifecycle": [
    "Init restablece estado; Task10ms cuenta inactividad.",
    "ProcessEvent decide consumo/desbloqueo de entrada antes del gestor de la vista.",
    "OnPreferencesChanged aplica nuevas reglas; SaveTimeoutDraft solicita persistencia."
  ],
  "interactions": [
    "UiEventRouter consulta bloqueo antes de propagar eventos ordinarios.",
    "Permission puede mantener un flujo de PIN distinto al bloqueo por inactividad."
  ],
  "limitations": [
    "Bloqueo visual y autorización de comandos son políticas distintas.",
    "Requiere cadencia de 10 ms para interpretar correctamente el timeout."
  ],
  "modularity": "Pertenece a UI AutoMicro y depende de menús, preferencias y servicios de pantalla.",
