{
  "name": "autofinalrobo2-web",
  "version": "1.23.2",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "node tools/catalog-model-assets.mjs && node tools/sync-oled-library.mjs",
    "start": "vite",
    "predev": "node tools/catalog-model-assets.mjs && node tools/sync-oled-library.mjs",
    "dev": "vite",
    "proxy:lan": "node tools/lan-proxy.mjs",
    "build": "node tools/catalog-model-assets.mjs && node tools/sync-oled-library.mjs && tsc -b && vite build",
    "postbuild": "node tools/package-web.mjs --profile full",
    "package:littlefs": "node tools/package-web.mjs",
    "copy:esp": "node tools/copy-web-to-esp.mjs",
    "build:esp": "node tools/catalog-model-assets.mjs && node tools/sync-oled-library.mjs && tsc -b && vite build --mode esp && node tools/package-web.mjs --profile esp && npm run copy:esp",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "sonner": "^2.0.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.14",
    "terser": "5.51.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
