# Dependencias instaladas y caches recuperables; conservar manifests y lockfiles.
node_modules/
.pio/
.pio-cache/
.platformio/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*
.cache/
.vite/
.turbo/
.downloads/
.toolchains/
.tmp/
.codex-remote-attachments/
.codex-attachments/

# Salidas generadas.
/AutoFinalRobo2-Loader/*.exe
/AFR2-Loader-dist-*/
/AFR2-Loader-dist-*.zip
dist/
build/
out/
artifacts/
coverage/
*.tsbuildinfo
*.elf
*.hex
*.bin
*.map
*.o
*.a
*.d
*.su
*.log

# Datos locales y credenciales.
.env
.env.*
!.env.example
!.env.sample
*.local.*
**/data/config*.json*
/AutoFinalRobo2-ESP/data/config/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# CAD: descargar dependencias con procedencia; versionar bibliotecas propias.
/AutoFinalRobo2-CAD/vendor/
/AutoFinalRobo2-CAD/exports/
/AutoFinalRobo2-CAD/renders/
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
*.sch-bak
*.brd-bak
*.lck
~$*
_autosave-*
*.FCStd[0-9]
*.FCBak

# No excluir globalmente STEP/STL/GLB/PDF/FCStd ni archivos KiCad editables.

# Capturas regenerables del prototipo v17; conservar script de captura.
/AutoFinalRobo2-CAD/mecanica/brazo-antropomorfo/revision_v17/renders/
/AutoFinalRobo2-CAD/mecanica/brazo-antropomorfo/revision_v17/web_blanco/*.blend[0-9]
/AutoFinalRobo2-CAD/mecanica/auto-completo/servo_web_20261031/*.glb

# Copias de respaldo del editor; conservar el .blend fuente del sensor.
/AutoFinalRobo2-CAD/mecanica/sensor-bateria/*.blend[0-9]
# Borrador sustituido por la fuente editable _v2; copia archivada en exports/.
/AutoFinalRobo2-CAD/mecanica/sensor-bateria/AFR2_Sensor_Bateria_Cableado_20261109.blend
/AutoFinalRobo2-CAD/mecanica/sensor-bateria/*.blend@
