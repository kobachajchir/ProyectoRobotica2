.idea/
.DS_Store
Thumbs.db
Desktop.ini

# CAD: descargar dependencias con procedencia; versionar bibliotecas propias.
/AutoFinalRobo2-CAD/vendor/
/AutoFinalRobo2-CAD/exports/
/AutoFinalRobo2-CAD/renders/
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
*.sch-bak
*.brd-bak
*.lck
~$*
_autosave-*
*.FCStd[0-9]
*.FCBak

# No excluir globalmente STEP/STL/GLB/PDF/FCStd ni archivos KiCad editables.

# Capturas regenerables del prototipo v17; conservar script de captura.
/AutoFinalRobo2-CAD/mecanica/brazo-antropomorfo/revision_v17/renders/
/AutoFinalRobo2-CAD/mecanica/brazo-antropomorfo/revision_v17/web_blanco/*.blend[0-9]
